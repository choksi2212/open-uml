{
  "name": "open-uml",
  "version": "2.0.0",
  "description": "A completely offline, smooth, modern PlantUML editor with bundled rendering engine",
  "main": "dist-electron/main/index.js",
  "author": "Open UML",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 -t 30000 && electron .\" --kill-others",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm run dist && gh release create"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.5",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.openuml.app",
    "productName": "Open UML",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "app/assets/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "app/plantuml/plantuml.jar",
        "to": "plantuml/plantuml.jar"
      },
      {
        "from": "app/plantuml/plantuml-pdf-1.2025.10.jar",
        "to": "plantuml/plantuml-pdf.jar"
      }
    ],
    "fileAssociations": [
      {
        "ext": "puml",
        "name": "PlantUML Diagram",
        "description": "PlantUML Source File",
        "role": "Editor"
      },
      {
        "ext": "plantuml",
        "name": "PlantUML Diagram",
        "description": "PlantUML Source File",
        "role": "Editor"
      },
      {
        "ext": "iuml",
        "name": "PlantUML Include File",
        "description": "PlantUML Include File",
        "role": "Editor"
      },
      {
        "ext": "pu",
        "name": "PlantUML Diagram",
        "description": "PlantUML Source File",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico",
      "artifactName": "OpenUML-Setup-${version}.exe",
      "publisherName": "Open UML",
      "extraResources": [
        {
          "from": "app/plantuml/jre-win",
          "to": "plantuml/jre-win"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "app/assets/icon.icns",
      "artifactName": "OpenUML-${version}.dmg",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "LSMinimumSystemVersion": "10.15"
      },
      "extraResources": [
        {
          "from": "app/plantuml/jre-mac",
          "to": "plantuml/jre-mac"
        }
      ]
    }
  }
}
